# Lokāli: .env.local (DATABASE_URL). Serverī: .env (POSTGRES_PASSWORD, DOMAIN).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sp:TAVA_PAROLE@localhost:5432/sp
# Ja ports 5432 jau ir aizņemts (cita PostgreSQL), ieraksti DB_PORT=5433 un to pašu portu DATABASE_URL:
# DB_PORT=5433
DOMAIN=tavsdomens.lv
# AI skolotājs (atslēgu liec TIKAI .env / .env.local, nekad Git):
DEEPSEEK_API_KEY=
