# ======================================================================
# Study Pilot iestatījumi. NEKAD neliec šo failu ar īstām vērtībām GitHub!
# Serverī:  .env        (scripts/server-setup.sh to izveido automātiski)
# Lokāli:   .env.local  (DATABASE_URL + vajadzīgās atslēgas)
# ======================================================================

# --- Obligāti ---
DOMAIN=studypilot.lv
POSTGRES_PASSWORD=
# Tikai lokāli (serverī docker-compose to saliek pats):
DATABASE_URL=postgres://sp:TAVA_PAROLE@localhost:5432/sp
# Ja lokāli ports 5432 jau aizņemts: DB_PORT=5433 un tas pats ports DATABASE_URL
# DB_PORT=5433

# --- AI skolotājs (DeepSeek: platform.deepseek.com → API keys) ---
DEEPSEEK_API_KEY=
# AI_DAILY_LIMIT_FREE=10
# AI_DAILY_LIMIT_PREMIUM=100
# Globāls AI dienas limits visai sistēmai (izmaksu aizsardzība). Nav iestatīts = 1500; 0 vai tukšs = bez limita
# AI_DAILY_LIMIT_GLOBAL=1500
# Limiti vienai IP adresei (vienā skolā visi sēž aiz vienas IP, tāpēc nav pārāk stingri)
# REGISTER_LIMIT_PER_HOUR=40
# LOGIN_LIMIT_PER_IP=100
# Sesijas sīkdatne ir Secure (tikai HTTPS), ja NODE_ENV=production. COOKIE_SECURE=0 to izslēdz (tikai lokālai Docker pārbaudei bez HTTPS)
# COOKIE_SECURE=
# Neobligāti: atslēga AI atbilžu parakstam čata vēsturē (ja nav, tiek atvasināta no DEEPSEEK_API_KEY)
# AI_HISTORY_SECRET=
# Izmaksu aprēķinam admin panelī (USD par 1 miljonu tokenu, skat. DeepSeek cenas):
# AI_PRICE_IN=
# AI_PRICE_OUT=

# --- E-pasts (nav obligāts). Bez atslēgas e-pasta apstiprināšana un paroles atjaunošana ir izslēgtas ---
# EMAIL_PROVIDER=brevo          # brevo vai resend
# EMAIL_API_KEY=
# EMAIL_FROM=Study Pilot <jautajumi@studypilot.lv>

# --- Premium maksājumi ar Stripe (nav obligāti). Bez tiem Premium var piešķirt tikai administrators ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PREMIUM_PRICE_TEXT=4,99 € / mēnesī   # tikai teksts sākumlapai; īstā cena ir Stripe

# --- Rezerves kopijas ---
# BACKUP_KEEP_DAYS=7
