!/package-lock.json
!/tailwind.config.js
!/postcss.config.js
!/next.config.js
!/jsconfig.json
!/README.md
!/public/
!/src/
!/server/
!/.devcontainer/

# Still ignored inside the kept folders
node_modules/
.next/
.env
.env.local
.DS_Store
server/uploads/
